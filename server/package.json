{
  "name": "koscomlabor-server",
  "version": "0.1.0",
  "private": true,
  "description": "전국금융산업노동조합 코스콤지부 공식페이지 백엔드 API 서버 (방명록)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "start:systemd": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --migration-file-language sql",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations --migration-file-language sql"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.3.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
