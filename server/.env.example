# 값은 절대 커밋하지 않는다. 이 파일은 키 목록만 제공한다.
# 실제 값은 server/.env (로컬) 또는 /etc/koscomlabor/server.env (프로덕션 systemd)에 둔다.

# 서버 바인딩 (프로덕션: nginx 뒤 루프백 고정)
HOST=127.0.0.1
PORT=3001

# PostgreSQL 접속 문자열 (예: postgres://user:password@127.0.0.1:5432/guestbook)
DATABASE_URL=

# 관리자 정적 토큰 (복구·운영 curl 용) — openssl rand -base64 32 로 생성 (32바이트 이상)
ADMIN_API_TOKEN=

# Admin 로그인 비밀번호의 argon2id 해시 — **최초 부팅 시드 전용**.
# admin_credentials(id=1) 행이 없을 때만 1회 INSERT 되고, 이후에는 DB 행이 권위 값이다.
# 즉 이 값을 바꿔도 이미 가동 중인 서버의 비밀번호는 바뀌지 않는다.
#   - 운영 중 변경: 관리 화면의 "비밀번호 변경" (POST /admin/password)
#   - 분실 복구:    node scripts/set-password.mjs (DATABASE_URL 필요)
# 최초 생성:
#   echo -n "<비밀번호>" | node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=

# 업로드 파일 저장 경로 (프로덕션: Docker 볼륨 /data/uploads)
UPLOAD_DIR=./uploads

# 세션 쿠키 Secure 속성 — 프로덕션 true 고정. 로컬 http 테스트 시에만 false
COOKIE_SECURE=true

# IP HMAC-SHA-256 salt — openssl rand -base64 32 로 생성 (ip_hash 산출용)
IP_HASH_SECRET=

# CORS 허용 Origin (콤마 구분). 프로덕션 기본값은 공식페이지 도메인만.
# 로컬 개발 시: http://localhost:3000
CORS_ORIGINS=https://koscomlabor.cloud,https://www.koscomlabor.cloud,https://onnuri.koscomlabor.cloud

# nginx 리버스 프록시 뒤에서 실행 시 true (X-Forwarded-For 신뢰)
TRUST_PROXY=true

# 로그 레벨 (info | warn | error)
LOG_LEVEL=info
